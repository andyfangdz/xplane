    <Profile Id="XPT.Verbose.Memory" Name="XPT" Description="Bounded CPU scheduling, file/disk I/O and PresentMon-compatible presentation events" LoggingMode="Memory" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="XPT_System">
          <SystemProviderId Value="XPT_Kernel" />
        </SystemCollectorId>
        <EventCollectorId Value="XPT_Present">
          <EventProviders>
            <EventProviderId Value="Microsoft_Windows_Kernel_Process" />
            <EventProviderId Value="Microsoft_Windows_DxgKrnl" />
            <EventProviderId Value="Microsoft_Windows_Win32k" />
            <EventProviderId Value="Microsoft_Windows_Dwm_Core" />
            <EventProviderId Value="Microsoft_Windows_DXGI" />
            <EventProviderId Value="Microsoft_Windows_D3D9" />
          </EventProviders>
        </EventCollectorId>
      </Collectors>
      <TraceMergeProperties>
        <TraceMergeProperty Id="XPT_Merge" Name="XPT_Merge">
          <CustomEvents>
            <CustomEvent Value="ImageId" />
            <CustomEvent Value="BuildInfo" />
            <CustomEvent Value="VolumeMapping" />
            <CustomEvent Value="EventMetadata" />
          </CustomEvents>
        </TraceMergeProperty>
      </TraceMergeProperties>
    </Profile>
