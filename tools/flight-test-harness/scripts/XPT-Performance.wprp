<?xml version='1.0' encoding='utf-8'?>
<WindowsPerformanceRecorder Version="1.0">
  <!--Presentation event IDs and keywords from Intel PresentMon v2.5.1 (MIT), PresentData/PresentMonTraceSession.cpp and ETW headers. Windows 11 profile; no DxgKrnl Performance keyword.-->
  <Profiles>
    <SystemCollector Id="XPT_System" Name="XPT_System">
      <BufferSize Value="1024" />
      <!-- The measured system-wide event rate wrapped 512 MiB in about 8 seconds.
           Four GiB retains the bounded flight diagnostic interval on this host.
           Still verify actual kernel-event QPC coverage after every capture. -->
      <Buffers Value="4096" />
    </SystemCollector>
    <EventCollector Id="XPT_Present" Name="XPT_Present">
      <BufferSize Value="1024" />
      <Buffers Value="256" />
    </EventCollector>
    <SystemProvider Id="XPT_Kernel">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="SampledProfile" />
        <Keyword Value="CSwitch" />
        <Keyword Value="ReadyThread" />
        <Keyword Value="DiskIO" />
        <Keyword Value="DiskIOInit" />
        <Keyword Value="FileIO" />
        <Keyword Value="FileIOInit" />
        <Keyword Value="HardFaults" />
        <Keyword Value="DPC" />
        <Keyword Value="Interrupt" />
      </Keywords>
      <Stacks>
        <Stack Value="SampledProfile" />
        <Stack Value="CSwitch" />
        <Stack Value="ReadyThread" />
        <Stack Value="DiskReadInit" />
        <Stack Value="DiskWriteInit" />
        <Stack Value="PagefaultHard" />
      </Stacks>
    </SystemProvider>
    <EventProvider Id="Microsoft_Windows_Kernel_Process" Name="22FB2CD6-0E7B-422B-A0C7-2FAD1FD0E716" NonPagedMemory="true" Level="4" Strict="true">
      <Keywords>
        <Keyword Value="0x8000000000000010" />
